#!/usr/bin/env bash
# start-mu2e-shift-scheduler — install/update dependencies and start the server
#
# Usage:
#   ./scripts/start-mu2e-shift-scheduler [options]
#
# Options:
#   --admin-password <pass>   Password for the local admin account
#                             (or set MU2E_INITIAL_ADMIN_PASSWORD env var)
#   --admin-email <email>     Email for the local admin account
#                             (or set MU2E_INITIAL_ADMIN_EMAIL; default mu2e-admin@fnal.gov)
#   --host <host>             Bind address (default: 127.0.0.1; --prod implies 0.0.0.0)
#   --port <port>             Port to listen on (default: 8001)
#   --prod                    Serve with gunicorn and production cookie settings
#   --debug                   Run the Flask dev server with debug/reload enabled
#   --no-update               Skip pip dependency update checks
#   --tail                    Tail the server log after starting
#
# Subsequent starts:
#   The script is safe to run repeatedly. It updates packages and restarts the
#   server if one is already running. Configuration precedence is
#   command line > environment > .env > defaults.

set -euo pipefail

# ── Colours ───────────────────────────────────────────────────────────────────
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'
RED='\033[0;31m'; BOLD='\033[1m'; RESET='\033[0m'
info()    { printf "${CYAN}==> %s${RESET}\n" "$*"; }
success() { printf "${GREEN}[OK] %s${RESET}\n" "$*"; }
warn()    { printf "${YELLOW}[WARN] %s${RESET}\n" "$*"; }
error()   { printf "${RED}[ERROR] %s${RESET}\n" "$*" >&2; }
header()  { printf "\n${BOLD}%s${RESET}\n%s\n" "$*" "$(printf '%.0s─' {1..60})"; }

# ── Paths ─────────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PID_FILE="$SCRIPT_DIR/.mu2e-shift-scheduler.pid"
LOG_DIR="$SCRIPT_DIR/logs"
LOG_FILE="$LOG_DIR/mu2e-shift-scheduler.log"
VENV_DIR="$PROJECT_DIR/venv"

# ── Load .env (variables already exported in the shell take precedence) ──────
if [[ -f "$PROJECT_DIR/.env" ]]; then
  while IFS= read -r _line; do
    [[ "$_line" =~ ^[[:space:]]*(#|$) ]] && continue
    _key="${_line%%=*}"; _key="${_key// /}"
    [[ -z "$_key" || "${!_key+set}" == "set" ]] && continue
    _val="${_line#*=}"
    if [[ "${_val:0:1}" == '"' && "${_val: -1}" == '"' ]]; then
      _val="${_val:1:${#_val}-2}"
    elif [[ "${_val:0:1}" == "'" && "${_val: -1}" == "'" ]]; then
      _val="${_val:1:${#_val}-2}"
    fi
    export "$_key=$_val"
  done < "$PROJECT_DIR/.env"
  unset _line _key _val
fi

# ── Arguments ─────────────────────────────────────────────────────────────────
HOST=""
PORT="${MU2E_SCHEDULER_PORT:-8001}"
PROD=false
DEBUG=false
UPDATE=true
TAIL_LOG=false

while [[ $# -gt 0 ]]; do
  case $1 in
    --admin-password) export MU2E_INITIAL_ADMIN_PASSWORD="$2"; shift 2 ;;
    --admin-email)    export MU2E_INITIAL_ADMIN_EMAIL="$2";    shift 2 ;;
    --host)           HOST="$2";  shift 2 ;;
    --port)           PORT="$2";  shift 2 ;;
    --prod)           PROD=true;  shift ;;
    --debug)          DEBUG=true; shift ;;
    --no-update)      UPDATE=false; shift ;;
    --tail)           TAIL_LOG=true; shift ;;
    -h|--help)
      awk '/^# Usage:/{show=1} show && /^#/{sub(/^# ?/, ""); print; next} show{exit}' "$0"
      exit 0 ;;
    *) error "Unknown option: $1"; exit 1 ;;
  esac
done

header "Mu2e Shift Scheduler"

# ── Python / venv ─────────────────────────────────────────────────────────────
if [[ ! -x "$VENV_DIR/bin/python" ]]; then
  info "Creating virtual environment in venv/..."
  PYTHON=""
  for cmd in python3.12 python3.11 python3.10 python3; do
    if command -v "$cmd" >/dev/null 2>&1 \
       && "$cmd" -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)' 2>/dev/null; then
      PYTHON="$cmd"; break
    fi
  done
  [[ -z "$PYTHON" ]] && { error "Python 3.10 or newer is required."; exit 1; }
  "$PYTHON" -m venv "$VENV_DIR"
fi
PY="$VENV_DIR/bin/python"

if [[ "$UPDATE" == true ]]; then
  info "Installing/updating dependencies..."
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -r "$PROJECT_DIR/requirements-dev.txt"
  "$PY" -m pip install --quiet -e "$PROJECT_DIR"
  success "Dependencies up to date"
else
  info "Skipping dependency update (--no-update)"
fi

# ── Environment defaults (dev-friendly unless --prod) ────────────────────────
if [[ "$PROD" == true ]]; then
  HOST="${HOST:-0.0.0.0}"
  export SESSION_COOKIE_SECURE="${SESSION_COOKIE_SECURE:-1}"
  export SHOW_ADMIN_LOGIN="${SHOW_ADMIN_LOGIN:-0}"
else
  HOST="${HOST:-127.0.0.1}"
  export SESSION_COOKIE_SECURE="${SESSION_COOKIE_SECURE:-0}"
  export SHOW_ADMIN_LOGIN="${SHOW_ADMIN_LOGIN:-1}"
fi

if [[ -z "${MU2E_INITIAL_ADMIN_PASSWORD:-}" && "${SHOW_ADMIN_LOGIN}" == "1" ]]; then
  warn "MU2E_INITIAL_ADMIN_PASSWORD is not set — no local admin account will be seeded."
  warn "Pass --admin-password or set it in .env for first-time setup."
fi

# ── Restart if already running ────────────────────────────────────────────────
if [[ -f "$PID_FILE" ]]; then
  OLD_PID=$(cat "$PID_FILE")
  if kill -0 "$OLD_PID" 2>/dev/null; then
    info "Server already running (PID $OLD_PID) — restarting..."
    "$SCRIPT_DIR/stop-mu2e-shift-scheduler" >/dev/null
  else
    rm -f "$PID_FILE"
  fi
fi

# ── Start ─────────────────────────────────────────────────────────────────────
mkdir -p "$LOG_DIR"
cd "$PROJECT_DIR"

if [[ "$PROD" == true ]]; then
  info "Starting gunicorn on ${HOST}:${PORT}..."
  nohup "$VENV_DIR/bin/gunicorn" \
      --bind "${HOST}:${PORT}" \
      --workers "${GUNICORN_WORKERS:-3}" \
      --timeout "${GUNICORN_TIMEOUT:-120}" \
      wsgi:app >> "$LOG_FILE" 2>&1 &
elif [[ "$DEBUG" == true ]]; then
  info "Starting Flask dev server (debug) on ${HOST}:${PORT}..."
  nohup "$PY" run.py --host "$HOST" --port "$PORT" --debug >> "$LOG_FILE" 2>&1 &
else
  info "Starting Flask dev server on ${HOST}:${PORT}..."
  nohup "$PY" run.py --host "$HOST" --port "$PORT" >> "$LOG_FILE" 2>&1 &
fi
SERVER_PID=$!
echo "$SERVER_PID" > "$PID_FILE"

# ── Health check ──────────────────────────────────────────────────────────────
sleep 1
for _ in {1..20}; do
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    error "Server exited during startup. Last log lines:"
    tail -20 "$LOG_FILE" >&2
    rm -f "$PID_FILE"
    exit 1
  fi
  if curl -sf -o /dev/null "http://127.0.0.1:${PORT}/login"; then
    break
  fi
  sleep 0.5
done

success "Server running (PID $SERVER_PID) — http://${HOST}:${PORT}/"
success "Log: $LOG_FILE"
echo   "     Stop with: ./scripts/stop-mu2e-shift-scheduler"

if [[ "$TAIL_LOG" == true ]]; then
  info "Tailing server log (Ctrl-C to detach; the server keeps running)"
  tail -f "$LOG_FILE"
fi
