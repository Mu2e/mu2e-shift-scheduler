# Mu2e Shift Scheduler — local configuration
# Copy to .env and edit. Precedence: command line > environment > .env > defaults.

# Local admin account (seeded/updated at startup when a password is set)
#MU2E_INITIAL_ADMIN_PASSWORD=change-me
#MU2E_INITIAL_ADMIN_EMAIL=mu2e-admin@fnal.gov
#MU2E_INITIAL_ADMIN_USERNAME=mu2e-admin

# Show the local admin password form on the login page (1 = show)
#SHOW_ADMIN_LOGIN=1

# Flask session security (0 for plain-http local development)
#SESSION_COOKIE_SECURE=0
#FLASK_SECRET_KEY=change-me-in-production

# Server
#MU2E_SCHEDULER_PORT=8001

# Storage paths (defaults: csv/, data/, data/users.sqlite, data/app.sqlite)
#CSV_DIR=csv
#DATA_DIR=data
#AUTH_DB_PATH=data/users.sqlite
#APP_DB_PATH=data/app.sqlite
#PREFERENCES_SHIFTS_CSV=csv/shifts.csv
#PREFERENCES_JSON=data/preferences.json
#SCHEDULER_CONFIG=config/config.yaml

# Fermilab SSO (leave unset to disable OIDC locally)
#OIDC_PROVIDER_URL=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_CLIENT_SECRET_FILE=
